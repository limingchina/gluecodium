#!/bin/bash -e
#

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. "${SCRIPT_DIR}/inc.functions"

USAGE=$(cat <<EOF
$0 [options]
    --publish             Build and publish Gluecodium locally and use it for code generation
    --buildGluecodium         Build and use local Gluecodium version
    --gluecodiumPath [PATH]   Implies --buildGluecodium, path to local gluecodium (default: ${GLUECODIUM_PATH})
    --python [PATH]       Path to Python interpreter with pybind11 installed (default: auto-detect)
    --debug               Build with debug symbols
    --verbose             Print Gluecodium/Gradle code-generation output (recommended for debugging hangs)
    --quiet               Suppress the verbose Gluecodium/Gradle code-generation output
    --help                Print this message

Environment variables:
    GLUECODIUM_PYTHON     Same as --python; takes precedence over auto-detection
EOF
)

# --- progress / diagnostics helpers -----------------------------------------
BUILD_START=$(date +%s)
_DIAG_PRINTED=0

step() {
    echo ""
    echo "==================================================================="
    echo "[$(date '+%H:%M:%S')] >>> $1"
    echo "==================================================================="
}

elapsed() {
    local now
    now=$(date +%s)
    local sec=$(( now - BUILD_START ))
    printf '%dm%02ds' $((sec / 60)) $((sec % 60))
}

# Print a snapshot of the processes most likely to be responsible for a hang:
# stuck Gradle daemons, the Gluecodium generation JVM, and the lock file that
# serializes Gradle invocations (file(LOCK ...) waits up to 600s for it).
dump_diagnostics() {
    echo ""
    echo "-------------------------------------------------------------------"
    echo "[$(date '+%H:%M:%S')] BUILD DIAGNOSTICS (elapsed $(elapsed))"
    echo "-------------------------------------------------------------------"
    echo ">> Gradle daemons still running:"
    pgrep -fl GradleDaemon 2>/dev/null || echo "   (none)"
    echo ">> Gluecodium generation JVM processes:"
    pgrep -fl "gluecodium/details/build/classes" 2>/dev/null || echo "   (none)"
    echo ">> ninja processes:"
    pgrep -fl "ninja" 2>/dev/null || echo "   (none)"
    echo ">> Gradle lock file (a stuck process can hold it for up to 600s):"
    if [[ -e "${BUILD_DIR}/gluecodium-gradle-lock.cmake" ]]; then
        ls -la "${BUILD_DIR}/gluecodium-gradle-lock.cmake"
        echo "   If none of the Gradle/Gluecodium processes above are active, this"
        echo "   lock is stale. Remove it to avoid a long wait:"
        echo "   rm -f ${BUILD_DIR}/gluecodium-gradle-lock.cmake"
    else
        echo "   (not present)"
    fi
}

dump_diagnostics_once() {
    [[ $_DIAG_PRINTED -eq 1 ]] && return
    _DIAG_PRINTED=1
    dump_diagnostics
}

# Run a command with a periodic heartbeat so a hang is visible. Once it runs
# longer than WATCHDOG_THRESHOLD seconds, diagnostics are printed repeatedly.
run_with_watchdog() {
    local interval=30
    local threshold=${WATCHDOG_THRESHOLD:-300}
    "$@" &
    local pid=$!
    local sec=0
    while kill -0 "$pid" 2>/dev/null; do
        sleep "$interval"
        sec=$((sec + interval))
        echo "[$(date '+%H:%M:%S')] (heartbeat) still running for ${sec}s: $*"
        if [[ $sec -ge $threshold ]]; then
            echo "[$(date '+%H:%M:%S')] (watchdog) build is taking unusually long; diagnostics:"
            dump_diagnostics
        fi
    done
    wait "$pid"
    return $?
}

BUILD_LOCAL_GLUECODIUM=false
CMAKE_EXTRA_PARAMETERS=
VERBOSE_BUILD=ON   # default ON: the Gradle code-generation step is the usual hang point
PYTHON_BIN_OVERRIDE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --publish)
            publish_local
            shift
            ;;
        --buildGluecodium)
            BUILD_LOCAL_GLUECODIUM=true
            shift
            ;;
        --gluecodiumPath)
            BUILD_LOCAL_GLUECODIUM=true
            GLUECODIUM_PATH="$2"
            shift 2
            ;;
        --python)
            PYTHON_BIN_OVERRIDE="$2"
            shift 2
            ;;
        --debug)
            CMAKE_EXTRA_PARAMETERS="-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            shift
            ;;
        --verbose)
            VERBOSE_BUILD=ON
            shift
            ;;
        --quiet)
            VERBOSE_BUILD=OFF
            shift
            ;;
        --help|*)
            echo "$USAGE"
            exit 0
            ;;
    esac
done

if [[ "$BUILD_LOCAL_GLUECODIUM" = "true" ]]; then
    export GLUECODIUM_PATH
fi

# GLUECODIUM_VERBOSE makes the code-generation step (which shells out to Gradle)
# print its output instead of swallowing it. This is the single most useful
# signal when the build appears stuck at "Run Build Command(s): ninja -v".
if [[ "$VERBOSE_BUILD" = "ON" ]]; then
    export GLUECODIUM_VERBOSE=ON
fi

# --- Python interpreter detection -------------------------------------------
#
# The pybind11 extension module's SOABI suffix is tied to the Python version that
# built it, so the *same* interpreter must be used for both building and testing.
# We auto-detect a Python 3.8+ interpreter with pybind11 installed by probing:
#
#   1. --python CLI option / GLUECODIUM_PYTHON env var (explicit override)
#   2. python3 on the current PATH
#   3. Common conda / miniconda / anaconda installation paths
#   4. Homebrew Python (Apple Silicon then Intel)
#   5. System Python (/usr/bin/python3)
#
# The first candidate that satisfies all checks (version >= 3.8, can import
# pybind11, and can report its CMake directory) is used. If none qualify, the
# script exits with a diagnostic message.

detect_python() {
    local candidate
    local candidates=()

    # 1. Explicit override via CLI or env var
    #    When an override is given, ONLY try that interpreter — do not fall
    #    back to auto-detection. The user asked for a specific one.
    if [[ -n "${PYTHON_BIN_OVERRIDE}" ]]; then
        if _validate_python "${PYTHON_BIN_OVERRIDE}"; then
            echo "${PYTHON_BIN_OVERRIDE}"
            return 0
        fi
        cat >&2 <<ERROR

ERROR: The Python interpreter specified via --python does not meet requirements:
  ${PYTHON_BIN_OVERRIDE}

It must be Python 3.8+ with pybind11 installed (pip install pybind11).
ERROR
        return 1
    elif [[ -n "${GLUECODIUM_PYTHON:-}" ]]; then
        if _validate_python "${GLUECODIUM_PYTHON}"; then
            echo "${GLUECODIUM_PYTHON}"
            return 0
        fi
        cat >&2 <<ERROR

ERROR: The Python interpreter specified via GLUECODIUM_PYTHON does not meet requirements:
  ${GLUECODIUM_PYTHON}

It must be Python 3.8+ with pybind11 installed (pip install pybind11).
ERROR
        return 1
    fi

    # 2. Auto-detection: python3 on PATH
    local path_python
    path_python=$(command -v python3 2>/dev/null || true)
    [[ -n "$path_python" ]] && candidates+=("$path_python")

    # 3. Common conda / miniconda / anaconda paths
    local conda_bases=(
        "$HOME/miniconda3/bin/python3"
        "$HOME/miniconda/bin/python3"
        "$HOME/anaconda3/bin/python3"
        "$HOME/anaconda/bin/python3"
        "/opt/miniconda3/bin/python3"
        "/opt/anaconda3/bin/python3"
        "/usr/local/miniconda3/bin/python3"
        "/usr/local/anaconda3/bin/python3"
    )
    for c in "${conda_bases[@]}"; do
        [[ -x "$c" ]] && candidates+=("$c")
    done

    # 4. Homebrew Python (macOS)
    local brew_bases=(
        "/opt/homebrew/bin/python3"   # Apple Silicon
        "/usr/local/bin/python3"       # Intel Mac / Linuxbrew
    )
    for c in "${brew_bases[@]}"; do
        [[ -x "$c" ]] && candidates+=("$c")
    done

    # 5. System Python
    [[ -x "/usr/bin/python3" ]] && candidates+=("/usr/bin/python3")

    # De-duplicate while preserving order
    local seen=""
    local unique=()
    for c in "${candidates[@]}"; do
        local real
        real=$(readlink -f "$c" 2>/dev/null || echo "$c")
        if [[ " $seen " != *" $real "* ]]; then
            seen="$seen $real"
            unique+=("$c")
        fi
    done

    for candidate in "${unique[@]}"; do
        if _validate_python "$candidate"; then
            echo "$candidate"
            return 0
        fi
    done

    # Nothing found — print a helpful error
    cat >&2 <<'ERROR'

ERROR: No suitable Python 3.8+ interpreter with pybind11 was found.

The Python functional tests require a Python interpreter that has pybind11
installed (used to build the CPython extension module). The following
locations were checked:

  - python3 on PATH
  - ~/miniconda3, ~/miniconda, ~/anaconda3, ~/anaconda
  - /opt/miniconda3, /opt/anaconda3
  - /opt/homebrew/bin/python3, /usr/local/bin/python3
  - /usr/bin/python3

To fix this:
  1. Install pybind11:  pip install pybind11
  2. Or specify an interpreter explicitly:
       ./scripts/build-python-functional --python /path/to/python3
       # or:
       GLUECODIUM_PYTHON=/path/to/python3 ./scripts/build-python-functional

ERROR
    return 1
}

# Check that a Python interpreter is version >= 3.8 and has pybind11.
_validate_python() {
    local py="$1"

    # Must exist and be executable
    [[ -x "$py" ]] || return 1

    # Must be Python 3.8+
    local version
    version=$("$py" -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")' 2>/dev/null) || return 1
    local major minor
    major=${version%%.*}
    minor=${version#*.}
    [[ "$major" -eq 3 && "$minor" -ge 8 ]] || return 1

    # Must be able to import pybind11 and report its CMake directory
    "$py" -c 'import pybind11' 2>/dev/null || return 1
    "$py" -m pybind11 --cmakedir >/dev/null 2>&1 || return 1

    return 0
}

step "Detecting Python interpreter (with pybind11)"
PYTHON_BIN=$(detect_python) || die "Python detection failed"
PYTHON_VERSION=$("$PYTHON_BIN" --version 2>&1)
PYBIND11_CMAKE_DIR=$("$PYTHON_BIN" -m pybind11 --cmakedir)
echo "  Using: $PYTHON_BIN ($PYTHON_VERSION)"
echo "  pybind11 CMake dir: $PYBIND11_CMAKE_DIR"

# Export so that CMake's find_package(Python) and any subprocesses see the same
# interpreter on PATH (CMake's Python_EXECUTABLE is set explicitly below, but
# some tools may still fall back to PATH).
export PATH="$(dirname "$PYTHON_BIN"):$PATH"

GLUECODIUM_VERSION="${GLUECODIUM_VERSION:-+}"
# Derive the project root from the script location so the build works regardless
# of the caller's current working directory (the CMake invocation below uses ".."
# relative to BUILD_DIR, which must resolve to the functional-tests source tree).
PROJECT_ROOT="${SCRIPT_DIR}/.."
BUILD_DIR=${PROJECT_ROOT}/build-python
INSTALL_DIR=${PROJECT_ROOT}/dist/python

[ -d "${BUILD_DIR}" ] || mkdir -p "${BUILD_DIR}"
[ -d "${INSTALL_DIR}" ] || mkdir -p "${INSTALL_DIR}"

# Warn early about a leftover lock from an interrupted previous run. A stale
# lock makes the next Gradle invocation block for up to 600s inside file(LOCK).
if [[ -e "${BUILD_DIR}/gluecodium-gradle-lock.cmake" ]]; then
    echo "WARNING: leftover Gradle lock file found: ${BUILD_DIR}/gluecodium-gradle-lock.cmake"
    echo "         A previous build may have been interrupted. If no Gradle/Gluecodium"
    echo "         process is currently running, remove it to avoid a 600s lock wait:"
    echo "         rm -f ${BUILD_DIR}/gluecodium-gradle-lock.cmake"
fi

set -x
CWD=${PWD}
pushd "${BUILD_DIR}"

tmppipe=$(mktemp -u)
mkfifo -m 600 "$tmppipe"
trap 'ec=$?; rm -rf "$tmppipe" 2>/dev/null; [[ $ec -ne 0 ]] && dump_diagnostics_once' EXIT
trap 'rm -rf "$tmppipe" 2>/dev/null; dump_diagnostics_once; exit 1' HUP INT TERM
step "CMake configure (generators: cpp;python)"
tee cmake_output.log < "$tmppipe" &
safe cmake \
    -DBUILD_SHARED_LIBS=ON \
    -DCMAKE_C_COMPILER_LAUNCHER=ccache \
    -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    -DCMAKE_C_COMPILER="$(which clang)" \
    -DCMAKE_CXX_COMPILER="$(which clang++)" \
    -DCMAKE_INSTALL_PREFIX="${INSTALL_DIR}" \
    -DCMAKE_VERBOSE_MAKEFILE=ON \
    -DGLUECODIUM_GENERATORS_DEFAULT="cpp;python" \
    -DGLUECODIUM_VERSION_DEFAULT="${GLUECODIUM_VERSION}" \
    -DFUNCTIONAL_BUILD_PYTHON_TESTS=ON \
    -DPython_EXECUTABLE="${PYTHON_BIN}" \
    -Dpybind11_DIR="${PYBIND11_CMAKE_DIR}" \
    -G Ninja \
    ${CMAKE_EXTRA_PARAMETERS} \
    .. > "$tmppipe"
popd

step "CMake build (pass 1: generates pybind11 sources via Gradle)"
safe run_with_watchdog cmake --build "${BUILD_DIR}"

# The pybind11 binding sources are generated as part of the build above, but the
# extension module target globs them at *configure* time. Re-run CMake so the
# glob picks up the now-generated sources, then build again to compile the
# extension module and copy the wrapper package next to it.
step "CMake re-configure (glob the now-generated pybind11 sources)"
pushd "${BUILD_DIR}"
safe cmake .
popd

step "CMake build (pass 2: compiles the Python extension module)"
safe run_with_watchdog cmake --build "${BUILD_DIR}"

step "Running CTest"
pushd "${BUILD_DIR}"
safe ctest --verbose
popd

step "BUILD FINISHED (elapsed $(elapsed))"
