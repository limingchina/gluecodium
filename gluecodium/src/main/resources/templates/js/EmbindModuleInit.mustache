template<class Clock, class Duration>
emscripten::val gluecodium_date_to_js(const std::chrono::time_point<Clock, Duration>& value) {
  const auto milliseconds = std::chrono::duration_cast<std::chrono::milliseconds>(value.time_since_epoch()).count();
  return emscripten::val::global("Date").new_(emscripten::val::global("Number")(milliseconds));
}

template<class TimePoint>
TimePoint gluecodium_date_to_native(emscripten::val value) {
  const auto milliseconds = static_cast<std::int64_t>(value.call<double>("getTime"));
  return TimePoint(
      std::chrono::duration_cast<typename TimePoint::duration>(std::chrono::milliseconds(milliseconds)));
}

template<class Rep, class Period>
emscripten::val gluecodium_duration_to_js(const std::chrono::duration<Rep, Period>& value) {
  return emscripten::val(value.count());
}

template<class Duration>
Duration gluecodium_duration_to_native(emscripten::val value) {
  return Duration(value.as<typename Duration::rep>());
}

#include "{{localeInclude}}"

{{localeTypeName}} gluecodium_locale_to_native(emscripten::val value) {
  return {{localeTypeName}}(value.as<std::string>());
}

emscripten::val gluecodium_locale_to_js(const {{localeTypeName}}& value) {
  if (value.language_tag) {
    return emscripten::val(*value.language_tag);
  }
  std::string result;
  if (value.language_code) result = *value.language_code;
  if (value.script_code) {
    if (!result.empty()) result += "-";
    result += *value.script_code;
  }
  if (value.country_code) {
    if (!result.empty()) result += "-";
    result += *value.country_code;
  }
  return emscripten::val(result.empty() ? "und" : result);
}

