LIME structs map to embind value_object (value semantics, all fields public).
}}
{{#constants}}
{{cppType}} {{functionName}}() {
  return {{cppFullName}};
}
{{/constants}}

void {{registerName}}(void) {
    value_object<{{cppFullName}}>("{{embindName}}")
{{#fields}}
{{^hasAccessors}}{{^hasBlob}}{{^hasDate}}{{^hasDuration}}{{^hasLocale}}{{^hasCollection}}
    .field("{{jsName}}", &{{cppFullName}}::{{cppFieldName}})
{{/hasCollection}}{{/hasLocale}}{{/hasDuration}}{{/hasDate}}{{/hasBlob}}{{/hasAccessors}}
{{#hasDate}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> emscripten::val {
    return {{dateGetter}};
  }, +[] ({{cppFullName}}& self, emscripten::val value) {
    {{dateSetter}};
  })
{{/hasDate}}
{{#hasDuration}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> emscripten::val {
    return gluecodium_duration_to_js(self.{{cppFieldName}});
  }, +[] ({{cppFullName}}& self, emscripten::val value) {
    self.{{cppFieldName}} = gluecodium_duration_to_native<decltype(self.{{cppFieldName}})>(value);
  })
{{/hasDuration}}
{{#hasLocale}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> emscripten::val {
    return {{localeGetter}};
  }, +[] ({{cppFullName}}& self, emscripten::val value) {
    {{localeSetter}};
  })
{{/hasLocale}}
{{#hasAccessors}}
{{^hasDate}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> {{accessorType}} {
    return self.{{cppGetterName}}();
  }, +[] ({{cppFullName}}& self, {{accessorType}} value) {
    self.{{cppSetterName}}(value);
  })
{{/hasDate}}
{{/hasAccessors}}
{{#hasBlob}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> emscripten::val {
    return self.{{cppFieldName}} ? emscripten::val::array(*self.{{cppFieldName}}) : emscripten::val::undefined();
  }, +[] ({{cppFullName}}& self, emscripten::val value) {
    self.{{cppFieldName}} = ::std::make_shared<::std::vector<uint8_t>>(
        emscripten::convertJSArrayToNumberVector<uint8_t>(value));
  })
{{/hasBlob}}
{{#hasCollection}}
{{^hasAccessors}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> emscripten::val {
    return {{collectionGetter}};
  }, +[] ({{cppFullName}}& self, emscripten::val value) {
    self.{{cppFieldName}} = {{collectionSetter}};
  })
{{/hasAccessors}}
{{/hasCollection}}
{{/fields}}
        ;
{{#constants}}
  function("{{runtimeName}}", &{{functionName}});
{{/constants}}
}
