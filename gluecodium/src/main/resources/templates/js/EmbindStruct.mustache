void {{registerName}}(void) {
{{^isObjectStruct}}
    value_object<{{cppFullName}}>("{{embindName}}")
{{#fields}}
{{^hasAccessors}}{{^hasBlob}}{{^hasImmutableStruct}}{{^hasDate}}{{^hasDuration}}{{^hasLocale}}{{^hasCollection}}
    .field("{{jsName}}", &{{cppFullName}}::{{cppFieldName}})
{{/hasCollection}}{{/hasLocale}}{{/hasDuration}}{{/hasDate}}{{/hasImmutableStruct}}{{/hasBlob}}{{/hasAccessors}}
{{#hasImmutableStruct}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> emscripten::val {
    return {{immutableGetter}};
  }, +[] ({{cppFullName}}& self, emscripten::val value) {
    {{immutableSetter}};
  })
{{/hasImmutableStruct}}
{{#hasDate}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> emscripten::val {
    return {{dateGetter}};
  }, +[] ({{cppFullName}}& self, emscripten::val value) {
    {{dateSetter}};
  })
{{/hasDate}}
{{#hasDuration}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> emscripten::val {
    return {{durationGetter}};
  }, +[] ({{cppFullName}}& self, emscripten::val value) {
    {{durationSetter}};
  })
{{/hasDuration}}
{{#hasLocale}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> emscripten::val {
    return {{localeGetter}};
  }, +[] ({{cppFullName}}& self, emscripten::val value) {
    {{localeSetter}};
  })
{{/hasLocale}}
{{#hasAccessors}}
{{^hasDate}}{{^hasCollection}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> {{accessorType}} {
    return self.{{cppGetterName}}();
  }, +[] ({{cppFullName}}& self, {{accessorType}} value) {
    self.{{cppSetterName}}(value);
  })
{{/hasCollection}}{{/hasDate}}
{{/hasAccessors}}
{{#hasBlob}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> emscripten::val {
    return self.{{cppFieldName}} ? emscripten::val::array({{#isNullable}}**{{/isNullable}}{{^isNullable}}*{{/isNullable}}self.{{cppFieldName}}) : emscripten::val::undefined();
  }, +[] ({{cppFullName}}& self, emscripten::val value) {
    self.{{cppFieldName}} = {{#isNullable}}(value.isNull() || value.isUndefined() ? decltype(self.{{cppFieldName}}){} : {{/isNullable}}::std::make_shared<::std::vector<uint8_t>>(
        emscripten::convertJSArrayToNumberVector<uint8_t>(value)){{#isNullable}}){{/isNullable}};
  })
{{/hasBlob}}
{{#hasCollection}}
  .field("{{jsName}}", +[] (const {{cppFullName}}& self) -> emscripten::val {
    return {{collectionGetter}};
  }, +[] ({{cppFullName}}& self, emscripten::val value) {
    {{collectionSetter}};
  })
{{/hasCollection}}
{{/fields}}
        ;
{{/isObjectStruct}}
