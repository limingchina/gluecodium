// Custom pybind11 type_caster for Gluecodium's Locale type.
//
// The C++ Locale struct (in the internal namespace) has four optional<string> fields:
// language_code, country_code, script_code, and language_tag (BCP 47).
//
// On the Python side, Locale is represented as a plain str containing the BCP 47
// language tag (e.g. "en-US", "sr-Cyrl"). This mirrors the approach used by the
// Dart and Swift generators.
//
// Conversion rules (matching the Dart/Swift approach):
//  * Python str -> C++ Locale:  Locale(std::string{tag})  — sets only language_tag.
//  * C++ Locale -> Python str:
//      - If language_tag is present, return it (BCP 47 tag takes precedence).
//      - Otherwise, synthesize a tag from the ISO code components:
//        language[-script][-country], omitting empty parts.
//      - If all components are absent, return "und" (undefined locale).

#pragma once

#include <pybind11/pybind11.h>
#include <optional>
#include <string>

#include "{{localeInclude}}"

namespace pybind11::detail {

template <>
struct type_caster<{{localeTypeFullName}}> {
    PYBIND11_TYPE_CASTER({{localeTypeFullName}}, _("str"));

    // Python str -> C++ Locale
    bool load(handle source, bool) {
        if (!pybind11::isinstance<pybind11::str>(source)) return false;
        std::string tag = pybind11::cast<std::string>(source);
        value = {{localeTypeFullName}}(std::move(tag));
        return true;
    }

    // C++ Locale -> Python str
    static handle cast(const {{localeTypeFullName}}& src, return_value_policy, handle) {
        // BCP 47 language tag takes precedence if present.
        if (src.language_tag.has_value()) {
            return pybind11::str(*src.language_tag).release();
        }
        // Otherwise, synthesize a BCP-47-style tag from the ISO code components.
        std::string tag;
        if (src.language_code.has_value() && !src.language_code->empty()) {
            tag = *src.language_code;
        }
        if (src.script_code.has_value() && !src.script_code->empty()) {
            if (!tag.empty()) tag += "-";
            tag += *src.script_code;
        }
        if (src.country_code.has_value() && !src.country_code->empty()) {
            if (!tag.empty()) tag += "-";
            tag += *src.country_code;
        }
        if (tag.empty()) tag = "und";
        return pybind11::str(tag).release();
    }
};

}  // namespace pybind11::detail
