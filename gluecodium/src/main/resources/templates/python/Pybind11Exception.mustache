{{! pybind11 exception binding body — exception translator registration. }}
{{! Uses scope and pybindName instead of module/registerName for nested-scope support. }}
{{#model}}
{{#instanceOf model.errorType.type.actualType "LimeEnumeration"}}
    static py::exception<::std::error_code> exc_{{pybindName}}({{scope}}, "{{pybindName}}");
    py::register_exception_translator([](std::exception_ptr p) {
        try {
            if (p) std::rethrow_exception(p);
        } catch (const ::std::error_code& e) {
            PyErr_SetString(exc_{{pybindName}}.ptr(), e.message().c_str());
        }
    });
    pybind11::detail::registerReturnError<::std::error_code>(exc_{{pybindName}}.ptr());
{{/instanceOf}}
{{#notInstanceOf model.errorType.type.actualType "LimeEnumeration"}}
    static py::object py_exc_{{pybindName}} =
        py::module_::import("{{resolveName model "" "ref"}}"){{pybind11AttrChain}};
    py::register_exception_translator([](std::exception_ptr p) {
        try {
            if (p) std::rethrow_exception(p);
        } catch (const {{resolveName model.errorType "Pybind11"}}& e) {
            const auto message = pybind11::detail::ReturnErrorToString<{{resolveName model.errorType "Pybind11"}}>::convert(e);
            PyErr_SetString(py_exc_{{pybindName}}.ptr(), message.c_str());
        }
    });
    pybind11::detail::registerReturnError<{{resolveName model.errorType "Pybind11"}}>(py_exc_{{pybindName}}.ptr());
{{/notInstanceOf}}
{{/model}}
