{{! Python property (getter + optional setter delegating to native). }}
{{#if isStatic}}{{#if comment}}{{prefix comment ""}}
{{/if}}    @staticmethod
    def {{resolveName}}(){{#unless typeRef.isNullable}} -> {{resolveName typeRef}}{{/unless}}:
{{#if comment}}        """{{resolveName comment}}"""
{{/if}}        return {{nativeModule}}.{{typeName}}.{{resolveName}}()
{{/if}}{{#unless isStatic}}{{#if comment}}{{prefix comment "    "}}
{{/if}}    @property
    def {{resolveName}}(self){{#unless typeRef.isNullable}} -> {{resolveName typeRef}}{{/unless}}:
{{#if comment}}        """{{resolveName comment}}"""
{{/if}}{{#ifPredicate "isAncestorProperty"}}        from {{resolveName typeRef "" "ref"}} import {{resolveName typeRef}}
{{/ifPredicate}}{{#ifPredicate model "isInterface"}}        return {{nativeModule}}.{{typeName}}.{{resolveName}}.fget(self)
{{/ifPredicate}}{{#unlessPredicate model "isInterface"}}        return self._native.{{resolveName}}
{{/unlessPredicate}}

{{#ifPredicate "hasSetter"}}
{{#if setterComment}}{{prefix setterComment "    "}}
{{/if}}    @{{resolveName}}.setter
    def {{resolveName}}(self, value{{#unless typeRef.isNullable}}: {{resolveName typeRef}}{{/unless}}):
{{#if setterComment}}        """{{resolveName setterComment}}"""
{{/if}}{{#ifPredicate model "isInterface"}}        {{nativeModule}}.{{typeName}}.{{resolveName}}.fset(self, value)
{{/ifPredicate}}{{#unlessPredicate model "isInterface"}}        self._native.{{resolveName}} = value
{{/unlessPredicate}}{{/ifPredicate}}
{{/unless}}
