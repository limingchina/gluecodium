{{! Python struct: dataclass-like wrapper around the native C++ object. }}

from _native_base import _NativeBase

import {{nativeModule}}


class {{resolveName}}(_NativeBase):
    """{{resolveName comment}}"""

    def __init__(self, *args, **kwargs):
        if len(args) == 1 and not kwargs and isinstance(args[0], {{nativeModule}}.{{typeName}}):
            super().__init__(args[0])
        else:
            super().__init__({{nativeModule}}.{{typeName}}(
                *[_unwrap(arg) for arg in args],
                **{k: _unwrap(v) for k, v in kwargs.items()}
            ))
{{#ifPredicate "isEquatable"}}

    def __eq__(self, other: object) -> bool:
        if not isinstance(other, type(self)):
            return False
        return self._native == other._native

    def __hash__(self) -> int:
        return hash(self._native)
