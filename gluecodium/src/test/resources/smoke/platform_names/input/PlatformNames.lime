package smoke

@Cpp("fooTypes")
@Java("barTypes")
@Swift("bazTypes")
@Dart("weeTypes")
@Kotlin("dodoTypes")
@Python(Name = "QuxTypes")
struct PlatformNames {

    @Cpp("fooStruct")
    @Java("barStruct")
    @Swift("bazStruct")
    @Dart("weeStruct")
    @Kotlin("dodoStruct")
    @Python(Name = "QuxStruct")
    struct BasicStruct {

        @Cpp("FOO_FIELD")
        @Java("BAR_FIELD")
        @Swift("BAZ_FIELD")
        @Dart("WEE_FIELD")
        @Kotlin("DODO_FIELD")
        @Python(Name = "qux_field")
        stringField: String

        @Cpp("FooCreate")
        @Java("BarCreate")
        @Swift("BazCreate")
        @Dart("WeeCreate")
        @Kotlin("DodoCreate")
        @Python(Name = "qux_make")
        constructor make(

            @Cpp("FooParameter")
            @Java("BarParameter")
            @Swift(Name = "BazParameter", Label = "_")
            @Dart("WeeParameter")
            @Kotlin("DodoParameter")
            @Python(Name = "qux_parameter")
            basicParameter: String
        )
    }

    @Cpp("fooEnum")
    @Java("barEnum")
    @Swift("bazEnum")
    @Dart("werrEnum")
    @Kotlin("dodoEnum")
    @Python(Name = "QuxEnum")
    enum BasicEnum {

        @Cpp("foo_item")
        @Java("bar_item")
        @Swift("BAZ_ITEM")
        @Dart("WEE_ITEM")
        @Kotlin("DODO_ITEM")
        @Python(Name = "QUX_ITEM")
        BASIC_ITEM
    }

    @Cpp("fooTypedef")
    @Swift("bazTypedef")
    @Kotlin("dodoTypedef")
    @Python(Name = "QuxTypedef")
    typealias BasicTypedef = Double
}

