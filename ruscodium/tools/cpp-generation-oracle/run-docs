#!/usr/bin/env bash
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../../.." && pwd)
java=${JAVA_HOME:+$JAVA_HOME/bin/}java
javac=${JAVA_HOME:+$JAVA_HOME/bin/}javac
lib="$repo/gluecodium/build/install/gluecodium/lib"
classes=$(mktemp -d)
trap 'rm -rf "$classes"' EXIT
"$javac" -cp "$lib/*" -d "$classes" "$repo/ruscodium/tools/reference-model/ReferenceModel.java" "$here/CppGenerationOracle.java"
cd "$repo"
output=${1:-$repo/ruscodium/tests/cpp-documentation-goldens}
for group in docs comments-file-interface comments-file-lambda; do
  CPP_ORACLE_RAW_COMMENTS=1 "$java" -cp "$classes:$lib/*" CppGenerationOracle "$group" "$output/$group"
  rm -f "$output/$group/stage.txt" "$output/$group/metadata.json"
done
