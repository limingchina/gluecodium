#!/usr/bin/env bash
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../../.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
"$here/run-docs" "$tmp"
for group in docs comments-file-interface comments-file-lambda; do
  diff -qr "$repo/ruscodium/tests/cpp-documentation-goldens/$group" "$tmp/$group"
done
"$here/compile-docs" "$tmp"
echo 'Verified complete JVM documentation captures.'
