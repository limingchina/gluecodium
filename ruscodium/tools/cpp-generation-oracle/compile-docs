#!/usr/bin/env bash
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../../.." && pwd)
captures=${1:-$repo/ruscodium/tests/cpp-documentation-goldens}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
for group in docs comments-file-interface comments-file-lambda; do
  root="$captures/$group/files/cpp"
  mapfile -d '' sources < <(find "$root/src" -name '*.cpp' -print0 | sort -z)
  "${CXX:-c++}" -std=c++17 -Wall -Wextra -Werror -I "$root/include" "${sources[@]}" "$here/$group-consumer.cc" -o "$tmp/$group-consumer"
  "$tmp/$group-consumer"
  echo "Compiled and ran $group consumer (${#sources[@]} generated source files)"
done
