#!/usr/bin/env python3
"""Run the complete C++ parity, formatter and strict/runtime consumer gates."""
import argparse, subprocess
from pathlib import Path
HERE=Path(__file__).resolve().parent
def main():
 p=argparse.ArgumentParser(description=__doc__)
 for name in ('native','snapshot-inventory','lime-inventory','gtest-source','capture'):p.add_argument('--'+name,required=True,type=Path)
 p.add_argument('--revision',required=True);p.add_argument('--native-compiler',required=True);p.add_argument('--jobs',default='2');args=p.parse_args();capture=args.capture.resolve()
 if capture.exists() and any(capture.iterdir()):raise SystemExit('capture must be empty')
 capture.mkdir(parents=True,exist_ok=True);common=['--native',args.native.resolve(),'--snapshot-inventory',args.snapshot_inventory.resolve(),'--lime-inventory',args.lime_inventory.resolve(),'--revision',args.revision,'--native-compiler',args.native_compiler];statuses=[]
 def call(label,argv):
  result=subprocess.run([str(x) for x in argv]);statuses.append((label,result.returncode))
 for name,program in [('smoke','run'),('functional','functional-check')]:call(name,[HERE/program,*common,'--capture',capture/name,'--report',capture/(name+'.json')])
 call('markdown',[HERE/'markdown-check','--capture',capture/'markdown','--report',capture/'markdown.json'])
 for label,output in [('jvm','files'),('native','lime-files')]:
  functional=capture/'functional';base=[HERE/'compile-functional.py','--inventory',functional/'inventory/functional-inventory.json','--generated',functional/'functional'/output,'--expected-inventory',functional/'functional/manifest.json','--gtest-source',args.gtest_source.resolve(),'--jobs',args.jobs,'--collect-errors']
  call('consumer-'+label+'-strict',[*base,'--output',capture/('consumer-'+label+'-strict'),'--label',label+'-strict'])
  call('consumer-'+label+'-compatibility',[*base,'--output',capture/('consumer-'+label+'-compatibility'),'--label',label+'-compatibility','--upstream-warning','reorder','--upstream-warning','unused-parameter','--upstream-warning','sign-compare','--upstream-warning','unused-result','--upstream-warning','unused-variable','--upstream-include','cstdint'])
  call('namerules-consumer-'+label,[HERE/'compile-namerules.py','--generated',functional/'namerules'/output,'--output',capture/('namerules-consumer-'+label),'--label',label])
 functional=capture/'functional'
 call('consumer-parity',[HERE/'consumer-parity.py','--functional-report',capture/'functional.json',
  '--jvm-strict',capture/'consumer-jvm-strict/report.json','--native-strict',capture/'consumer-native-strict/report.json',
  '--jvm-compat',capture/'consumer-jvm-compatibility/report.json','--native-compat',capture/'consumer-native-compatibility/report.json',
  '--jvm-generated',functional/'functional/files','--native-generated',functional/'functional/lime-files',
  '--jvm-names',capture/'namerules-consumer-jvm/report.json','--native-names',capture/'namerules-consumer-native/report.json',
  '--jvm-names-generated',functional/'namerules/files','--native-names-generated',functional/'namerules/lime-files',
  '--report',capture/'consumer-parity.json'])
 print('Completion gate results:',', '.join(f'{name}={status}' for name,status in statuses),flush=True)
 # Strict commands intentionally fail for catalogued upstream diagnostics.
 # Only the independently checked parity result can accept these failures.
 expected_strict={'consumer-jvm-strict','consumer-native-strict','namerules-consumer-jvm','namerules-consumer-native'}
 if any(status for name,status in statuses if name not in expected_strict):raise SystemExit(1)
if __name__=='__main__':main()
