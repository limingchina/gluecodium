#           define GLUE_EXPORT __declspec( dllexport )
#       else
#           define GLUE_EXPORT __declspec( dllimport )
#       endif
#   else
#       define GLUE_EXPORT __attribute__( ( visibility( "default" ) ) )
#   endif
#else
#   define GLUE_EXPORT
#endif
