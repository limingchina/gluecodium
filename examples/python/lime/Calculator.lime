package com.example.calculator

// The result of a calculation, passed by value.
struct Calculation {
    expression: String
    value: Double
}

// Implement this interface in Python to observe successful calculations.
interface CalculationListener {
    fun onCalculated(result: Calculation)
}

enum CalculatorErrorCode {
    DIVISION_BY_ZERO
}

exception CalculatorError(CalculatorErrorCode)

// Arithmetic implemented in C++ and exposed through Python wrappers.
class Calculator {
    constructor create()

    fun add(left: Double, right: Double): Calculation
    fun subtract(left: Double, right: Double): Calculation
    fun multiply(left: Double, right: Double): Calculation
    fun divide(left: Double, right: Double): Calculation throws CalculatorError

    fun setListener(listener: CalculationListener)
    property calculationCount: Int
}
