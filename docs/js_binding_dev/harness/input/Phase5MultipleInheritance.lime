package phase5

lambda StringTransformer = (String) -> String

open class OpenClass {
    fun parentFunction(): String
    property parentProperty: String
}

narrow interface NarrowInterface {
    fun parentFunctionLight(): String
    property parentPropertyLight: String
}

interface JsCallback {
    fun invoke(value: String): String
}

class MultiClass: OpenClass, NarrowInterface {
    fun childFunction(): String
    property childProperty: String
}

class MultipleInheritanceFactory {
    static fun getMultiClass(): MultiClass
    static fun getMultiClassAsNarrow(): NarrowInterface
    static fun upcastToNarrow(instance: MultiClass): NarrowInterface
    static fun invokeJsCallback(callback: JsCallback): String
    static fun invokeLambda(callback: StringTransformer, value: String): String
}
