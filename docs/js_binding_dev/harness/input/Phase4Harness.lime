package phase4

enum Mode {
    Off,
    On
}

struct Sample {
    count: Int
    label: String
}

class Harness {
    static fun add(first: Int, second: Int): Int
    constructor create(seed: Int)
    property value: Int
    fun increment(amount: Int): Int
    fun self(): Harness
    fun nullableValue(input: Int?): Int?
    fun sum(values: List<Int>): Int
    fun lookup(values: Map<String, Int>, key: String): Int?
    fun roundTripSet(values: Set<String>): Set<String>
    fun roundTripNestedSet(values: Set<Set<Int>>): Set<Set<Int>>
    fun roundTripNullableSet(values: Set<Int>?): Set<Int>?
    fun roundTripNestedNullableList(values: List<List<Int>?>): List<List<Int>?>
    fun roundTrip(sample: Sample): Sample
    fun roundTripMode(mode: Mode): Mode
    fun roundTripLong(value: Long): Long
}
